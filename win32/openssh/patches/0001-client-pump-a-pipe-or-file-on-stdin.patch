+		if (!sync_pump_deliver_locked(p))
+			pio->read_details.pending = TRUE;   /* the pump will wake us */
+		LeaveCriticalSection(&p->lock);
+		return 0;
 	}
 
 	read_thread = (HANDLE) _beginthreadex(NULL, 0, ReadThread, pio, 0, NULL);
@@ -277,6 +520,11 @@ syncio_close(struct w32_io* pio)
 		SleepEx(0, TRUE);
 	}
 
+	if (pio->internal.context) {
+		sync_pump_stop(pio);
+		pio->read_details.pending = FALSE;
+	}
+
 	CancelIoEx(WINHANDLE(pio), NULL);
 
 	/* If io is pending, let worker threads exit. */
