+/*
+ * rsync-windows: hand the buffer's storage to a caller that will use it
+ * asynchronously (the socket pump sends it as it stands), taking *dp of
+ * *allocp bytes in exchange, or a fresh allocation of the same size when
+ * *dp is NULL.  The buffer looks unchanged from its own point of view --
+ * off and size stay, so the caller consumes what it took as it would
+ * after a write() -- but bytes below size in the new storage are not the
+ * old ones.  On return *dp, *allocp and *offp describe the storage given
+ * up and where its data starts.
+ */
+int
+sshbuf_swap_storage(struct sshbuf *buf, u_char **dp, size_t *allocp,
+    size_t *offp)
+{
+	u_char *nd = *dp;
+	size_t nalloc = *allocp;
+	int r;
+
+	if ((r = sshbuf_check_sanity(buf)) != 0)
+		return r;
+	if (buf->readonly || buf->refcount > 1 || buf->parent != NULL)
+		return SSH_ERR_BUFFER_READ_ONLY;
+	if (nd != NULL && (nalloc < buf->size || nalloc > buf->max_size))
+		return SSH_ERR_INVALID_ARGUMENT;
+	if (nd == NULL) {
+		nalloc = buf->alloc;
+		if ((nd = malloc(nalloc)) == NULL)
+			return SSH_ERR_ALLOC_FAIL;
+	}
+	*dp = buf->d;
+	*allocp = buf->alloc;
+	*offp = buf->off;
+	buf->d = nd;
+	buf->cd = nd;
+	buf->alloc = nalloc;
+	buf->hwm = buf->size;	/* the new storage is unknown up to there */
+	return 0;
+}
+
 int
 sshbuf_consume_end(struct sshbuf *buf, size_t len)
 {
