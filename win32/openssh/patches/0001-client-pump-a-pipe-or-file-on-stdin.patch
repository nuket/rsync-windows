+			p->waiting = FALSE;
+			p->apc_queued = TRUE;
+			wake = TRUE;
+		}
+		LeaveCriticalSection(&p->lock);
+		if (wake && !QueueUserAPC(SyncPumpWakeAPC, main_thread, (ULONG_PTR)&p->apc_queued)) {
+			EnterCriticalSection(&p->lock);
+			p->apc_queued = FALSE;
+			LeaveCriticalSection(&p->lock);
+		}
+		if (err)
+			break;
+	}
