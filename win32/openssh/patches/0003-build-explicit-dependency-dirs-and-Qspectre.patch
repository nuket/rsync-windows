diff --git a/contrib/win32/openssh/Directory.Build.targets b/contrib/win32/openssh/Directory.Build.targets
new file mode 100644
index 0000000..4470f4d
--- /dev/null
+++ b/contrib/win32/openssh/Directory.Build.targets
@@ -0,0 +1,33 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Picked up by every vcxproj in this directory, after the project's own
+     settings.  Two things for the rsync for Windows port:
+
+     /Qspectre: the projects already carry CFG, CET, /sdl, a static CRT and
+     LTCG; this adds the speculative-execution mitigation, so ssh.exe
+     matches the rsync.exe it ships with.
+
+     The port's own translation units, from win32/openssh in the parent
+     repository: the I/O pumps (into posix_compat, beside the files they
+     serve) and the CNG AES-GCM backend (into libssh, beside cipher.c).
+     The patches in win32/openssh/patches only hook Microsoft's files into
+     them.  A .targets rather than a .props so the items pick up the
+     projects' include directories, and the projects pick up ours.
+     RsyncWin32Dir can be given on the msbuild command line. -->
+<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
+  <PropertyGroup>
+    <RsyncWin32Dir Condition="'$(RsyncWin32Dir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\win32\openssh\</RsyncWin32Dir>
+  </PropertyGroup>
+  <ItemDefinitionGroup>
+    <ClCompile>
+      <AdditionalOptions>/Qspectre %(AdditionalOptions)</AdditionalOptions>
+      <!-- win32compat: posix_compat's own files find w32fd.h beside them; ours are elsewhere -->
+      <AdditionalIncludeDirectories>$(RsyncWin32Dir);$(OpenSSH-Src-Path)contrib\win32\win32compat;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
+    </ClCompile>
+  </ItemDefinitionGroup>
+  <ItemGroup Condition="'$(MSBuildProjectName)' == 'win32iocompat'">
+    <ClCompile Include="$(RsyncWin32Dir)win32pumps.c" />
+  </ItemGroup>
+  <ItemGroup Condition="'$(MSBuildProjectName)' == 'libssh'">
+    <ClCompile Include="$(RsyncWin32Dir)win32cnggcm.c" />
+  </ItemGroup>
+</Project>
diff --git a/contrib/win32/openssh/config.h.vs b/contrib/win32/openssh/config.h.vs
index 3a19ea0..de7a5b8 100644
--- a/contrib/win32/openssh/config.h.vs
+++ b/contrib/win32/openssh/config.h.vs
@@ -755,6 +755,11 @@
 /* Define to 1 if you have the `poll' function. */
 /* #undef HAVE_POLL */
 
+/* pselect() is provided by contrib/win32/win32compat/w32fd.c; the portable
+   fallback in openbsd-compat/bsd-pselect.c creates a pipe per call, which
+   on Windows is a named pipe and costs a third of a bulk transfer. */
+#define HAVE_PSELECT 1
+
 /* Define to 1 if you have the <poll.h> header file. */
 #define HAVE_POLL_H 1
 
@@ -1765,6 +1770,10 @@
 #define HAVE_RSA_METH_SET_PRIV_DEC 1
 #define HAVE_RSA_METH_SET_FINISH 1
 #define HAVE_EVP_PKEY_GET0_RSA 1
+/* LibreSSL has both; without these openbsd-compat supplies its own and a
+   static libcrypto.lib then defines them twice (a DLL import never did). */
+#define HAVE_EVP_DIGESTSIGN 1
+#define HAVE_EVP_DIGESTVERIFY 1
 #define HAVE_EVP_MD_CTX_NEW 1
 #define HAVE_EVP_MD_CTX_FREE 1
 
