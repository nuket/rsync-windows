diff --git a/contrib/win32/openssh/Directory.Build.props b/contrib/win32/openssh/Directory.Build.props
new file mode 100644
index 0000000..c0898c7
--- /dev/null
+++ b/contrib/win32/openssh/Directory.Build.props
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Picked up by every vcxproj in this directory.  The projects already
+     carry CFG, CET, /sdl, a static CRT and LTCG; this adds the speculative-
+     execution mitigation, so ssh.exe matches the rsync.exe it ships with. -->
+<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
+  <ItemDefinitionGroup>
+    <ClCompile>
+      <AdditionalOptions>/Qspectre %(AdditionalOptions)</AdditionalOptions>
+    </ClCompile>
+  </ItemDefinitionGroup>
+</Project>
diff --git a/contrib/win32/openssh/config.h.vs b/contrib/win32/openssh/config.h.vs
index 3a19ea0..0acd48d 100644
--- a/contrib/win32/openssh/config.h.vs
+++ b/contrib/win32/openssh/config.h.vs
@@ -1765,6 +1765,10 @@
 #define HAVE_RSA_METH_SET_PRIV_DEC 1
 #define HAVE_RSA_METH_SET_FINISH 1
 #define HAVE_EVP_PKEY_GET0_RSA 1
+/* LibreSSL has both; without these openbsd-compat supplies its own and a
+   static libcrypto.lib then defines them twice (a DLL import never did). */
+#define HAVE_EVP_DIGESTSIGN 1
+#define HAVE_EVP_DIGESTVERIFY 1
 #define HAVE_EVP_MD_CTX_NEW 1
 #define HAVE_EVP_MD_CTX_FREE 1
 
