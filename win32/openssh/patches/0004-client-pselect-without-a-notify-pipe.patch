+/*
+ * pselect(2) for Win32.
+ *
+ * Without this, OpenSSH's portable fallback (openbsd-compat/bsd-pselect.c)
+ * stands in, and it guards the gap between checking for a signal and
+ * blocking in select() by creating a notify pipe on EVERY call whenever a
+ * signal handler is installed -- which the client loop always has.  On
+ * Windows pipe() is a named pipe plus an open, two closes and the ACL work
+ * that goes with them: about a third of the client's main thread on a
+ * 20Gbit link, once per packet.
+ *
+ * The gap does not exist here.  Signals in this port are raised by queueing
+ * an APC to the main thread and setting pending_signals, and w32_select()
+ * waits alertably and processes pending signals both before it blocks and
+ * when it wakes -- so a signal arriving at any point interrupts the select
+ * the way the notify pipe was meant to.  The mask is honoured by the same
+ * sigprocmask() emulation the fallback used.
+ */
+int
+pselect(int nfds, w32_fd_set* readfds, w32_fd_set* writefds, w32_fd_set* exceptfds,
+	const struct timespec *timeout, const void *sigmask)
+{
+	struct timeval tv, *tvp = NULL;
+	sigset_t osig;
+	int ret, saved_errno;
+
+	if (timeout != NULL) {
+		tv.tv_sec = (long)timeout->tv_sec;
+		tv.tv_usec = (long)(timeout->tv_nsec / 1000);
+		tvp = &tv;
+	}
+	if (sigmask == NULL)
+		return w32_select(nfds, readfds, writefds, exceptfds, tvp);
+
+	sigprocmask(SIG_SETMASK, (const sigset_t *)sigmask, &osig);
+	ret = w32_select(nfds, readfds, writefds, exceptfds, tvp);
+	saved_errno = errno;
+	sigprocmask(SIG_SETMASK, &osig, NULL);
+	errno = saved_errno;
+	return ret;
+}
+
 #define SELECT_EVENT_LIMIT 512
 int
 w32_select(int fds, w32_fd_set* readfds, w32_fd_set* writefds, w32_fd_set* exceptfds, const struct timeval *timeout)
@@ -978,6 +1032,9 @@ w32_dup2(int oldfd, int newfd)
 		pio->internal.state = SOCK_READY;
 
 	fd_table_set(pio, newfd);
+	/* a shared-memory ring on stdin or stdout follows the dup
+	 * (rsync-windows, win32/openssh/win32shmio.c); a no-op otherwise */
