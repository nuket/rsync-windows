+		DWORD size = (FILETYPE(pio) == FILE_TYPE_CHAR) ? TERM_IO_BUF_SIZE : SYNC_IO_BULK_BUF_SIZE;
+		pio->read_details.buf = malloc(size);
 		if (pio->read_details.buf == NULL) {
 			errno = ENOMEM;
 			return -1;
 		}
-		pio->read_details.buf_size = TERM_IO_BUF_SIZE;
+		pio->read_details.buf_size = size;
+	}
+
+	if (sync_pump_wanted(pio)) {
+		struct sync_pump* p = (struct sync_pump*)pio->internal.context;
+
+		if (!p && !(p = sync_pump_start(pio)))
+			return -1;
