+		EnterCriticalSection(&p->lock);
+		if (err) {
+			/* dead: drop what is queued, report on the next write */
+			p->err = err;
+			p->len = 0;
+		} else {
+			p->head = (p->head + wrote) % SYNC_WPUMP_RING_SIZE;
+			p->len -= wrote;
+		}
